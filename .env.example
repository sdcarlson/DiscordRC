# Copy to .env and fill in values. Load into your shell with:
#   set -a; . ./.env; set +a

# MongoDB root credentials (used by api/mongo_setup.sh and the API)
MONGO_USERNAME=
MONGO_PASSWORD=
# Optional, defaults to localhost:27017
# MONGO_HOST=localhost:27017

# Secret used to sign JWT access tokens (e.g. output of: openssl rand -hex 32)
JWT_SECRET_KEY=

# Discord bot token used by DiscordBot/
DISCORD_TOKEN=
